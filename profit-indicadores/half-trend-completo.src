//=====================================================================
// HalfTrend Completo
// Indicador + Estrategia num arquivo so, para o Profit (Nelogica)
//
// Plota a linha e o canal, pinta os candles nas viradas e executa as
// ordens. Serve tanto inserido no grafico quanto rodando no Backtest.
//
// REGRAS
//   entrada   na virada da linha, a mercado
//   filtros   so entre HoraInicio e HoraFim, e so com ATR acima do minimo
//   posicao   2 contratos
//   parcial   1 contrato sai em +AlvoParcial pontos
//   runner    ContratosRunner seguem ate a linha virar contra a posicao
//             (SaidaPelaVirada = 1) ou ate AlvoRunner (= 0).
//
// Calibragem: 173 pregoes de WIN em 5 min. A avaliacao da mesa foi
// simulada comecando em CADA pregao da amostra, nao num caminho so, e
// medida por familia de parametros em vez de valor isolado, porque em
// 173 pregoes um valor isolado oscila muito.
//
// Familia Amplitude 3-4 + stop 275-310 + saida pela virada:
//   cerca de 1 sinal por dia, aprovacao 81-98% na primeira metade da
//   amostra e 80-100% na segunda, meta em 15 pregoes na mediana.
// Familia anterior, Amplitude 10-12 + stop 375-425 + alvo fixo:
//   cerca de 0,5 sinal por dia, aprovacao 93-100% e 40-84%, 20 pregoes.
//
// Ou seja: o dobro de sinais com chance de aprovacao equivalente. Mas o
// pior caso piora -- a eliminacao na primeira metade chega a 19% nesta
// familia contra 7% na anterior.
//
// Amplitude 2 e despenhadeiro: 67% de eliminacao. Nao reduza abaixo de 3.
//   stop      StopPontos, e vai para o zero a zero depois da parcial
//   dia       encerra tudo em HoraZerar, maximo MaxOperacoesDia entradas,
//             para de operar ao atingir AlvoDiaReais
//
// CORES
//   linha verde abaixo do preco  -> tendencia de alta
//   linha vermelha acima         -> tendencia de baixa
//   candle verde ou vermelho     -> virada valida
//   candle cinza                 -> virada barrada por um filtro
//
// ANTES DE RODAR O BACKTEST
//   No painel de Execucao, ajuste a Quantidade para 2.
//
// SE O F9 RECLAMAR DAS LINHAS DE ORDEM
//   Sua versao do NTSL nao aceita quantidade como argumento. Apague o
//   (2) e o (1) das quatro chamadas, deixando so BuyAtMarket,
//   SellShortAtMarket, SellToCoverAtMarket e BuyToCoverAtMarket. Nesse
//   caso a saida parcial deixa de existir: tudo sai de uma vez no alvo
//   do runner. Me avise, que eu adapto.
//
//   Se reclamar de  horaAtual := Time;  troque Time por CurrentTime.
//=====================================================================

input
  Amplitude(4);            // janela de maximas e minimas. Maior = menos viradas
  DesvioCanal(2.0);        // largura do canal, em multiplos de meio ATR
  PeriodoATR(100);         // periodo do ATR que define o canal
  FiltroHorario(1);        // 1 = liga o filtro de horario
  HoraInicio(900);         // formato HHMM
  HoraFim(1450);           // ultima virada valida. Entrada e no candle seguinte
  HoraZerar(1740);         // encerra qualquer posicao aberta
  FiltroVolatilidade(1);   // 1 = liga o filtro de ATR
  ATRMinimo(100);          // ATR minimo em pontos para o sinal valer.
                           // Era 200 quando o runner saia em alvo fixo: em
                           // mercado parado o alvo nao era alcancavel. Com a
                           // saida pela virada esse motivo sumiu, e 200 so
                           // cortava sinal: 0,92 por dia contra 1,01, mesmo
                           // acerto de 62% e R$64 por operacao contra R$69
  PeriodoATRFiltro(14);    // periodo do ATR usado no filtro
  FiltroVolume(1);         // 1 = liga o filtro de volume
  VolumeMaximo(1.0);       // volume da barra / media. Acima disso o sinal nao vale.
                           // 1.0 e o ponto certo, nao e "quanto menor melhor":
                           // desligado da 58% de acerto e 21% de eliminacao,
                           // em 1.0 da 62% e 2%, e apertando para 0.8 piora
                           // para 60% e 17%
  PeriodoVolume(20);       // quantas barras entram na media de volume
  FiltroRompimento(0);     // 1 = aceita tambem entrada por rompimento, alem da
                           //     virada da linha. Desligado por padrao: dobra
                           //     os sinais mas piora a sobrevivencia na mesa
  BarrasRompimento(6);     // rompe a maxima ou a minima destas barras
  IdadeMinima(12);         // barras de vida do regime para o rompimento valer.
                           //     Rompimento so funciona em tendencia madura
  StopPontos(300);         // stop em pontos. Faixa estavel medida: 275 a 310.
                           // Abaixo de 260 a eliminacao na mesa sobe muito
  ContratosParcial(2);     // contratos que saem no AlvoParcial
  ContratosRunner(2);      // contratos que seguem no runner
  AlvoParcial(250);        // alvo dos contratos da parcial
  AlvoRunner(500);         // alvo do runner quando SaidaPelaVirada = 0
  SaidaPelaVirada(1);      // 1 = runner segura ate a linha virar contra, em vez
                           //     de sair em AlvoRunner. Medido em 173 pregoes,
                           //     permite usar Amplitude menor (mais sinais) sem
                           //     piorar a chance de aprovacao na mesa
  UsarZeroAZero(1);        // 1 = stop vai ao zero a zero apos a parcial
  MaxOperacoesDia(3);      // entradas por pregao. 3 mede melhor que 2: nos poucos
                           // dias com varios sinais, o terceiro tambem e bom
  AlvoDiaReais(900);       // para de operar ao atingir este lucro no dia
  ValorPonto(0.20);        // WIN = 0,20. WDO = 10,00
  Operar(0);               // 0 = so desenha (sem setas) | 1 = envia ordens, para o Backtest
  MostrarCanal(1);
  PintarVirada(1);
  MarcarFiltrados(1);

var
  i            : integer;
  ultimaBarra  : integer;
  iniciado     : boolean;
  trend        : integer;   // 0 = alta, 1 = baixa
  trendAnt     : integer;
  nexttrend    : integer;
  maxLowPrice  : float;
  minHighPrice : float;
  up           : float;
  down         : float;
  upAnt        : float;
  downAnt      : float;
  somaTR       : float;
  tr           : float;
  atr2         : float;
  atrFiltro    : float;
  dev          : float;
  highPrice    : float;
  lowPrice     : float;
  somaH        : float;
  somaL        : float;
  highma       : float;
  lowma        : float;
  linha        : float;
  horaAtual    : integer;
  horaAnt      : integer;
  barrasHoje   : integer;
  somaVol      : float;
  mediaVol     : float;
  volRel       : float;
  nVol         : integer;
  horaOk       : boolean;
  volOk        : boolean;
  fluxoOk      : boolean;
  virouCompra  : boolean;
  virouVenda   : boolean;
  sinalValido  : boolean;
  idadeRegime  : integer;   // barras desde a ultima virada da linha
  minJanela    : float;
  maxJanela    : float;
  rompeCompra  : boolean;
  rompeVenda   : boolean;
  sinalPend    : integer;   // 0 = nenhum, 1 = compra, 2 = venda
  barraPend    : integer;   // barra em que o sinal pendente nasceu
  opsHoje      : integer;
  lucroHoje    : float;
  fezParcial   : boolean;
  entradaArmada: boolean;
  precoEntrada : float;
  stopAtual    : float;
  minBarras    : integer;

begin
  minBarras := PeriodoATR + PeriodoATRFiltro + Amplitude + 3;

  if (CurrentBar < minBarras) then
  begin
    PlotN(1, Close);
    PlotN(2, Close);
    PlotN(3, Close);
  end
  else
  begin
    horaAtual := Time;

    //-----------------------------------------------------------------
    // Virada de dia: zera os contadores.
    // Detectada quando a hora anda para tras, porque o NTSL nao expoe
    // a data diretamente.
    //-----------------------------------------------------------------
    if (horaAtual < horaAnt) then
    begin
      opsHoje    := 0;
      lucroHoje  := 0;
      sinalPend  := 0;
      barrasHoje := 0;
    end;
    horaAnt := horaAtual;

    //-----------------------------------------------------------------
    // A maquina de estado so pode avancar UMA VEZ por barra.
    // Sem esta trava, cada tick da barra em formacao avancaria o
    // estado de novo e corromperia a sequencia.
    //-----------------------------------------------------------------
    if (CurrentBar <> ultimaBarra) then
    begin
      ultimaBarra := CurrentBar;
      barrasHoje  := barrasHoje + 1;

      //--- meio ATR, que define a largura do canal
      somaTR := 0;
      for i := 0 to (PeriodoATR - 1) do
      begin
        tr := High[i] - Low[i];
        if (Abs(High[i] - Close[i + 1]) > tr) then
          tr := Abs(High[i] - Close[i + 1]);
        if (Abs(Low[i] - Close[i + 1]) > tr) then
          tr := Abs(Low[i] - Close[i + 1]);
        somaTR := somaTR + tr;
      end;
      atr2 := (somaTR / PeriodoATR) / 2;
      dev  := DesvioCanal * atr2;

      //--- ATR curto, usado so no filtro de volatilidade
      somaTR := 0;
      for i := 0 to (PeriodoATRFiltro - 1) do
      begin
        tr := High[i] - Low[i];
        if (Abs(High[i] - Close[i + 1]) > tr) then
          tr := Abs(High[i] - Close[i + 1]);
        if (Abs(Low[i] - Close[i + 1]) > tr) then
          tr := Abs(Low[i] - Close[i + 1]);
        somaTR := somaTR + tr;
      end;
      atrFiltro := somaTR / PeriodoATRFiltro;

      //--- maior maxima, menor minima e medias na janela da amplitude
      highPrice := High[0];
      lowPrice  := Low[0];
      somaH     := 0;
      somaL     := 0;
      for i := 0 to (Amplitude - 1) do
      begin
        if (High[i] > highPrice) then highPrice := High[i];
        if (Low[i]  < lowPrice)  then lowPrice  := Low[i];
        somaH := somaH + High[i];
        somaL := somaL + Low[i];
      end;
      highma := somaH / Amplitude;
      lowma  := somaL / Amplitude;

      //--- primeira barra calculavel: semeia o estado
      if (not iniciado) then
      begin
        iniciado     := true;
        trend        := 0;
        nexttrend    := 0;
        idadeRegime  := 0;
        maxLowPrice  := Low[0];
        minHighPrice := High[0];
        up           := lowPrice;
        down         := highPrice;
      end;

      trendAnt := trend;
      upAnt    := up;
      downAnt  := down;

      //--- avalia a virada, sempre, sem filtro nenhum
      if (nexttrend = 1) then
      begin
        if (lowPrice > maxLowPrice) then
          maxLowPrice := lowPrice;
        if ((highma < maxLowPrice) and (Close < Low[1])) then
        begin
          trend        := 1;
          nexttrend    := 0;
          minHighPrice := highPrice;
        end;
      end
      else
      begin
        if (highPrice < minHighPrice) then
          minHighPrice := highPrice;
        if ((lowma > minHighPrice) and (Close > High[1])) then
        begin
          trend       := 0;
          nexttrend   := 1;
          maxLowPrice := lowPrice;
        end;
      end;

      //--- ha quantas barras o regime atual dura
      if (trend <> trendAnt) then
        idadeRegime := 0
      else
        idadeRegime := idadeRegime + 1;

      //--- posiciona a linha
      virouCompra := false;
      virouVenda  := false;

      if (trend = 0) then
      begin
        if (trendAnt = 1) then
        begin
          up := downAnt;
          virouCompra := true;
        end
        else
        begin
          if (maxLowPrice > upAnt) then up := maxLowPrice else up := upAnt;
        end;
        linha := up;
      end
      else
      begin
        if (trendAnt = 0) then
        begin
          down := upAnt;
          virouVenda := true;
        end
        else
        begin
          if (minHighPrice < downAnt) then down := minHighPrice else down := downAnt;
        end;
        linha := down;
      end;

      //-----------------------------------------------------------------
      // FILTROS
      // Barram apenas o sinal. O estado acima ja foi atualizado: se ele
      // parasse fora do horario, o regime se perderia e a linha ficaria
      // errada no dia seguinte.
      //-----------------------------------------------------------------
      horaOk := true;
      if (FiltroHorario = 1) then
        horaOk := (horaAtual >= HoraInicio) and (horaAtual <= HoraFim);

      volOk := true;
      if (FiltroVolatilidade = 1) then
        volOk := (atrFiltro >= ATRMinimo);

      //-----------------------------------------------------------------
      // Filtro de volume.
      //
      // Contra-intuitivo de proposito: o sinal vale quando o volume da
      // barra da virada esta ABAIXO da media recente.
      //
      // O HalfTrend e seguidor de tendencia, e virada com volume alto
      // costuma ser climax, com o movimento ja esgotado. Virada
      // silenciosa ainda tem caminho.
      //
      // Medido em 173 pregoes com a estrutura atual: sem o filtro sao 58%
      // de acerto e 21% de eliminacao na metade dificil da amostra; com
      // VolumeMaximo 1.0 sao 62% e 2%. Apertar nao melhora -- em 0.8 cai
      // para 60% e 17%. O otimo e 1.0, nao e quanto menor melhor.
      //
      // A media usa apenas barras do pregao corrente, porque o volume
      // da abertura e do fechamento distorce a comparacao.
      //-----------------------------------------------------------------
      fluxoOk := true;
      if (FiltroVolume = 1) then
      begin
        nVol := PeriodoVolume;
        if ((barrasHoje - 1) < nVol) then
          nVol := barrasHoje - 1;

        if (nVol < 5) then
          fluxoOk := false          // cedo demais no pregao para comparar
        else
        begin
          somaVol := 0;
          for i := 1 to nVol do
            somaVol := somaVol + Volume[i];
          mediaVol := somaVol / nVol;
          if (mediaVol <= 0) then
            fluxoOk := false
          else
          begin
            volRel  := Volume[0] / mediaVol;
            fluxoOk := (volRel < VolumeMaximo);
          end;
        end;
      end;

      //-----------------------------------------------------------------
      // Entrada por rompimento (opcional, FiltroRompimento).
      //
      // Rompe a minima das ultimas BarrasRompimento barras estando a
      // linha em baixa, ou a maxima estando em alta. Sempre a favor da
      // linha, nunca contra.
      //
      // A trava de idade existe porque a medicao mostrou que rompimento
      // so funciona em tendencia ja estabelecida: sem ela, a eliminacao
      // na metade dificil da amostra vai a 56%. Com 12 barras, cai a 7%.
      //-----------------------------------------------------------------
      rompeCompra := false;
      rompeVenda  := false;
      if (FiltroRompimento = 1) then
      begin
        if (idadeRegime >= IdadeMinima) then
        begin
          if ((barrasHoje - 1) >= BarrasRompimento) then
          begin
            minJanela := Low[1];
            maxJanela := High[1];
            for i := 2 to BarrasRompimento do
            begin
              if (Low[i] < minJanela) then
                minJanela := Low[i];
              if (High[i] > maxJanela) then
                maxJanela := High[i];
            end;

            if (trend = 0) then
            begin
              if (Close > maxJanela) then
                rompeCompra := true;
            end
            else
            begin
              if (Close < minJanela) then
                rompeVenda := true;
            end;
          end;
        end;
      end;

      sinalValido := horaOk and volOk and fluxoOk;

      // O sinal fica pendente por uma barra. Isso importa quando o runner
      // sai pela virada da linha: a ordem de saida so executa na abertura
      // da barra seguinte, entao na barra do sinal a posicao ainda consta
      // aberta. Sem o pendente, toda entrada que nasce de uma virada que
      // tambem encerra a posicao anterior seria perdida.
      if (sinalValido) then
      begin
        if (virouCompra) then
        begin
          sinalPend := 1;
          barraPend := CurrentBar;
        end
        else if (virouVenda) then
        begin
          sinalPend := 2;
          barraPend := CurrentBar;
        end
        else if (rompeCompra) then
        begin
          sinalPend := 1;
          barraPend := CurrentBar;
        end
        else if (rompeVenda) then
        begin
          sinalPend := 2;
          barraPend := CurrentBar;
        end;
      end;
    end;

    //-----------------------------------------------------------------
    // DESENHO
    //-----------------------------------------------------------------
    PlotN(1, linha);
    if (trend = 0) then
      SetPlotColor(1, clLime)
    else
      SetPlotColor(1, clRed);

    if (MostrarCanal = 1) then
    begin
      PlotN(2, linha + dev);
      PlotN(3, linha - dev);
      SetPlotColor(2, clGray);
      SetPlotColor(3, clGray);
    end
    else
    begin
      PlotN(2, linha);
      PlotN(3, linha);
    end;

    if (PintarVirada = 1) then
    begin
      if (virouCompra) then
      begin
        if (sinalValido) then
          PaintBar(clLime)
        else if (MarcarFiltrados = 1) then
          PaintBar(clGray);
      end
      else if (virouVenda) then
      begin
        if (sinalValido) then
          PaintBar(clRed)
        else if (MarcarFiltrados = 1) then
          PaintBar(clGray);
      end
      else if (rompeCompra) then
      begin
        if (sinalValido) then
          PaintBar(clLime)
        else if (MarcarFiltrados = 1) then
          PaintBar(clGray);
      end
      else if (rompeVenda) then
      begin
        if (sinalValido) then
          PaintBar(clRed)
        else if (MarcarFiltrados = 1) then
          PaintBar(clGray);
      end;
    end;

    //-----------------------------------------------------------------
    // ORDENS
    //-----------------------------------------------------------------
    if (Operar = 1) then
    begin
      if (IsBought) then
      begin
        // primeira barra com a posicao aberta: pega o preenchimento real
        if (entradaArmada) then
        begin
          entradaArmada := false;
          precoEntrada  := BuyPrice;
          stopAtual     := BuyPrice - StopPontos;
          opsHoje       := opsHoje + 1;
        end;

        if (horaAtual >= HoraZerar) then
          SellToCoverAtMarket(ContratosParcial + ContratosRunner)
        else
        begin
          if (Low <= stopAtual) then
          begin
            if (fezParcial) then
            begin
              SellToCoverAtMarket(ContratosRunner);
              lucroHoje := lucroHoje + ((stopAtual - precoEntrada) * ContratosRunner * ValorPonto);
            end
            else
            begin
              SellToCoverAtMarket(ContratosParcial + ContratosRunner);
              lucroHoje := lucroHoje + ((stopAtual - precoEntrada)
                           * (ContratosParcial + ContratosRunner) * ValorPonto);
            end;
          end
          else
          begin
            if (not fezParcial) then
            begin
              if (High >= (precoEntrada + AlvoParcial)) then
              begin
                SellToCoverAtMarket(ContratosParcial);
                fezParcial := true;
                lucroHoje  := lucroHoje + (AlvoParcial * ContratosParcial * ValorPonto);
                if (UsarZeroAZero = 1) then
                  stopAtual := precoEntrada;
              end;
            end
            else
            begin
              //--- saida do runner
              if (SaidaPelaVirada = 1) then
              begin
                // segura ate a linha virar contra a posicao
                if (trend = 1) then
                begin
                  SellToCoverAtMarket(ContratosRunner);
                  lucroHoje := lucroHoje + ((Close - precoEntrada) * ContratosRunner * ValorPonto);
                end;
              end
              else
              begin
                if (High >= (precoEntrada + AlvoRunner)) then
                begin
                  SellToCoverAtMarket(ContratosRunner);
                  lucroHoje := lucroHoje + (AlvoRunner * ContratosRunner * ValorPonto);
                end;
              end;
            end;
          end;
        end;
      end
      else if (IsSold) then
      begin
        if (entradaArmada) then
        begin
          entradaArmada := false;
          precoEntrada  := SellPrice;
          stopAtual     := SellPrice + StopPontos;
          opsHoje       := opsHoje + 1;
        end;

        if (horaAtual >= HoraZerar) then
          BuyToCoverAtMarket(ContratosParcial + ContratosRunner)
        else
        begin
          if (High >= stopAtual) then
          begin
            if (fezParcial) then
            begin
              BuyToCoverAtMarket(ContratosRunner);
              lucroHoje := lucroHoje + ((precoEntrada - stopAtual) * ContratosRunner * ValorPonto);
            end
            else
            begin
              BuyToCoverAtMarket(ContratosParcial + ContratosRunner);
              lucroHoje := lucroHoje + ((precoEntrada - stopAtual)
                           * (ContratosParcial + ContratosRunner) * ValorPonto);
            end;
          end
          else
          begin
            if (not fezParcial) then
            begin
              if (Low <= (precoEntrada - AlvoParcial)) then
              begin
                BuyToCoverAtMarket(ContratosParcial);
                fezParcial := true;
                lucroHoje  := lucroHoje + (AlvoParcial * ContratosParcial * ValorPonto);
                if (UsarZeroAZero = 1) then
                  stopAtual := precoEntrada;
              end;
            end
            else
            begin
              if (SaidaPelaVirada = 1) then
              begin
                if (trend = 0) then
                begin
                  BuyToCoverAtMarket(ContratosRunner);
                  lucroHoje := lucroHoje + ((precoEntrada - Close) * ContratosRunner * ValorPonto);
                end;
              end
              else
              begin
                if (Low <= (precoEntrada - AlvoRunner)) then
                begin
                  BuyToCoverAtMarket(ContratosRunner);
                  lucroHoje := lucroHoje + (AlvoRunner * ContratosRunner * ValorPonto);
                end;
              end;
            end;
          end;
        end;
      end
      else
      begin
        //-------------------------------------------------------------
        // Sem posicao: avalia entrada
        //-------------------------------------------------------------
        if (sinalPend <> 0) then
        begin
          if ((CurrentBar - barraPend) <= 1) then
          begin
            if (opsHoje < MaxOperacoesDia) then
            begin
              if (lucroHoje < AlvoDiaReais) then
              begin
                if (sinalPend = 1) then
                  BuyAtMarket(ContratosParcial + ContratosRunner)
                else
                  SellShortAtMarket(ContratosParcial + ContratosRunner);

                // O preco de entrada NAO e definido aqui. A ordem executa
                // na abertura do candle seguinte, e so la o preenchimento
                // real existe. Fixar Close aqui desloca stop e alvos.
                //
                // opsHoje tambem NAO e incrementado aqui. No backtest real
                // de 67 pregoes apareceram 27 operacoes que abrem e fecham
                // no mesmo instante e no mesmo preco, com resultado zero.
                // Contadas no envio da ordem, elas queimavam uma das tres
                // vagas do dia e bloqueavam sinais de verdade. Agora a vaga
                // so e gasta quando a posicao realmente abre, abaixo.
                entradaArmada := true;
                fezParcial    := false;
              end;
            end;
          end;
          sinalPend := 0;
        end;
      end;
    end;
  end;
end;
