//=====================================================================
// HalfTrend
// Indicador NTSL para Profit (Nelogica)
//
// Porte do HalfTrend, indicador publico e gratuito originalmente
// escrito para MetaTrader (forex-indicators.org).
//
// COMO FUNCIONA
//   Mantem uma maquina de estado com dois modos, alta e baixa.
//   Em alta, a linha acompanha o maior piso recente e so sobe.
//   Em baixa, acompanha o menor teto recente e so desce.
//   A virada exige duas condicoes ao mesmo tempo: a media das maximas
//   (ou minimas) romper o piso guardado E o fechamento superar a
//   maxima ou minima da barra anterior.
//
//   Essa dupla condicao e o motivo de ele nao ficar virando a cada
//   repique. Nao e uma media movel disfarcada.
//
// SINAL
//   A virada da linha E o sinal. Linha verde = alta, vermelha = baixa.
//   O candle da virada e pintado.
//
// ATENCAO
//   Isto e uma reconstrucao a partir do algoritmo publico. Antes de
//   confiar, compare com o indicador original: exporte os buffers dele
//   com o ExportaIndicador.mq5 e confira barra a barra.
//=====================================================================

input
  Amplitude(2);        // janela de maximas e minimas. Maior = menos viradas
  DesvioCanal(2.0);    // largura do canal, em multiplos de meio ATR
  PeriodoATR(100);     // periodo do ATR que define o canal
  MostrarCanal(1);     // 1 = desenha as bordas do canal
  PintarVirada(1);     // 1 = pinta o candle onde a linha vira

var
  i            : integer;
  ultimaBarra  : integer;
  iniciado     : boolean;
  trend        : integer;   // 0 = alta, 1 = baixa
  trendAnt     : integer;
  nexttrend    : integer;
  maxLowPrice  : float;
  minHighPrice : float;
  up           : float;
  down         : float;
  upAnt        : float;
  downAnt      : float;
  somaTR       : float;
  tr           : float;
  atr2         : float;
  dev          : float;
  highPrice    : float;
  lowPrice     : float;
  somaH        : float;
  somaL        : float;
  highma       : float;
  lowma        : float;
  linha        : float;
  virouCompra  : boolean;
  virouVenda   : boolean;

begin
  if (CurrentBar < (PeriodoATR + Amplitude + 2)) then
  begin
    PlotN(1, Close);
    PlotN(2, Close);
    PlotN(3, Close);
  end
  else
  begin
    //-----------------------------------------------------------------
    // A maquina de estado so pode avancar UMA VEZ por barra.
    // Sem esta trava, cada tick da barra em formacao avancaria o
    // estado de novo e corromperia a sequencia.
    //-----------------------------------------------------------------
    if (CurrentBar <> ultimaBarra) then
    begin
      ultimaBarra := CurrentBar;

      //--- meio ATR, que define a largura do canal
      somaTR := 0;
      for i := 0 to (PeriodoATR - 1) do
      begin
        tr := High[i] - Low[i];
        if (Abs(High[i] - Close[i + 1]) > tr) then
          tr := Abs(High[i] - Close[i + 1]);
        if (Abs(Low[i] - Close[i + 1]) > tr) then
          tr := Abs(Low[i] - Close[i + 1]);
        somaTR := somaTR + tr;
      end;
      atr2 := (somaTR / PeriodoATR) / 2;
      dev  := DesvioCanal * atr2;

      //--- maior maxima, menor minima e medias na janela da amplitude
      highPrice := High[0];
      lowPrice  := Low[0];
      somaH     := 0;
      somaL     := 0;
      for i := 0 to (Amplitude - 1) do
      begin
        if (High[i] > highPrice) then highPrice := High[i];
        if (Low[i]  < lowPrice)  then lowPrice  := Low[i];
        somaH := somaH + High[i];
        somaL := somaL + Low[i];
      end;
      highma := somaH / Amplitude;
      lowma  := somaL / Amplitude;

      //--- primeira barra calculavel: semeia o estado
      if (not iniciado) then
      begin
        iniciado     := true;
        trend        := 0;
        nexttrend    := 0;
        maxLowPrice  := Low[0];
        minHighPrice := High[0];
        up           := lowPrice;
        down         := highPrice;
      end;

      trendAnt := trend;
      upAnt    := up;
      downAnt  := down;

      //--- avalia a virada
      if (nexttrend = 1) then
      begin
        if (lowPrice > maxLowPrice) then
          maxLowPrice := lowPrice;

        if ((highma < maxLowPrice) and (Close < Low[1])) then
        begin
          trend        := 1;
          nexttrend    := 0;
          minHighPrice := highPrice;
        end;
      end
      else
      begin
        if (highPrice < minHighPrice) then
          minHighPrice := highPrice;

        if ((lowma > minHighPrice) and (Close > High[1])) then
        begin
          trend       := 0;
          nexttrend   := 1;
          maxLowPrice := lowPrice;
        end;
      end;

      //--- posiciona a linha
      virouCompra := false;
      virouVenda  := false;

      if (trend = 0) then
      begin
        if (trendAnt = 1) then
        begin
          // virou para alta: a linha salta para onde estava a de baixa
          up := downAnt;
          virouCompra := true;
        end
        else
        begin
          // em alta a linha nunca desce
          if (maxLowPrice > upAnt) then
            up := maxLowPrice
          else
            up := upAnt;
        end;
        linha := up;
      end
      else
      begin
        if (trendAnt = 0) then
        begin
          down := upAnt;
          virouVenda := true;
        end
        else
        begin
          // em baixa a linha nunca sobe
          if (minHighPrice < downAnt) then
            down := minHighPrice
          else
            down := downAnt;
        end;
        linha := down;
      end;
    end;

    //-----------------------------------------------------------------
    // plotagem
    //-----------------------------------------------------------------
    PlotN(1, linha);
    if (trend = 0) then
      SetPlotColor(1, clLime)
    else
      SetPlotColor(1, clRed);

    if (MostrarCanal = 1) then
    begin
      PlotN(2, linha + dev);
      PlotN(3, linha - dev);
      SetPlotColor(2, clGray);
      SetPlotColor(3, clGray);
    end
    else
    begin
      PlotN(2, linha);
      PlotN(3, linha);
    end;

    if (PintarVirada = 1) then
    begin
      if (virouCompra) then
        PaintBar(clLime)
      else if (virouVenda) then
        PaintBar(clRed);
    end;
  end;
end;
