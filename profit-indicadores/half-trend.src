//=====================================================================
// HalfTrend com filtros
// Indicador NTSL para Profit (Nelogica)
//
// Porte do HalfTrend, indicador publico e gratuito originalmente
// escrito para MetaTrader (forex-indicators.org), com dois filtros
// medidos em 172 pregoes do mini indice:
//
//   HORARIO     sinal so vale entre 09h00 e 14h59.
//               Depois das 15h o acerto medido caiu de 74% para 56%.
//               O limite e 1450 e nao 1459 porque a entrada acontece
//               no candle seguinte a virada.
//
//   VOLATILIDADE  sinal so vale com ATR(14) acima de 200 pontos.
//               Com ATR abaixo disso o acerto foi de 57% e a
//               expectativa, negativa: os alvos de 250 e 500 pontos
//               nao sao alcancaveis em mercado parado.
//
//   Os dois juntos levaram o acerto de 66% para 73%.
//
// LEITURA DAS CORES DO CANDLE
//   verde / vermelho forte -> sinal valido, pode operar
//   cinza                  -> virada barrada por um dos filtros
//
// IMPORTANTE
//   Os filtros barram o SINAL, nunca o calculo. A maquina de estado
//   continua avancando em todas as barras: se ela parasse fora do
//   horario, o regime se perderia e a linha ficaria errada no dia
//   seguinte.
//=====================================================================

input
  Amplitude(12);           // janela de maximas e minimas. Maior = menos viradas
  DesvioCanal(2.0);        // largura do canal, em multiplos de meio ATR
  PeriodoATR(100);         // periodo do ATR que define o canal
  FiltroHorario(1);        // 1 = liga o filtro de horario
  HoraInicio(900);         // formato HHMM
  HoraFim(1450);           // formato HHMM. 1450 porque a entrada e no candle seguinte
  FiltroVolatilidade(1);   // 1 = liga o filtro de ATR
  ATRMinimo(200);          // ATR minimo em pontos para o sinal valer
  PeriodoATRFiltro(14);    // periodo do ATR usado no filtro
  MostrarCanal(1);         // 1 = desenha as bordas do canal
  PintarVirada(1);         // 1 = pinta o candle onde a linha vira
  MarcarFiltrados(1);      // 1 = pinta de cinza as viradas barradas

var
  i            : integer;
  ultimaBarra  : integer;
  iniciado     : boolean;
  trend        : integer;   // 0 = alta, 1 = baixa
  trendAnt     : integer;
  nexttrend    : integer;
  maxLowPrice  : float;
  minHighPrice : float;
  up           : float;
  down         : float;
  upAnt        : float;
  downAnt      : float;
  somaTR       : float;
  tr           : float;
  atr2         : float;
  atrFiltro    : float;
  dev          : float;
  highPrice    : float;
  lowPrice     : float;
  somaH        : float;
  somaL        : float;
  highma       : float;
  lowma        : float;
  linha        : float;
  horaAtual    : integer;
  horaOk       : boolean;
  volOk        : boolean;
  virouCompra  : boolean;
  virouVenda   : boolean;
  sinalValido  : boolean;
  minBarras    : integer;

begin
  minBarras := PeriodoATR + PeriodoATRFiltro + Amplitude + 3;

  if (CurrentBar < minBarras) then
  begin
    PlotN(1, Close);
    PlotN(2, Close);
    PlotN(3, Close);
  end
  else
  begin
    //-----------------------------------------------------------------
    // A maquina de estado so pode avancar UMA VEZ por barra.
    // Sem esta trava, cada tick da barra em formacao avancaria o
    // estado de novo e corromperia a sequencia.
    //-----------------------------------------------------------------
    if (CurrentBar <> ultimaBarra) then
    begin
      ultimaBarra := CurrentBar;

      //--- meio ATR, que define a largura do canal
      somaTR := 0;
      for i := 0 to (PeriodoATR - 1) do
      begin
        tr := High[i] - Low[i];
        if (Abs(High[i] - Close[i + 1]) > tr) then
          tr := Abs(High[i] - Close[i + 1]);
        if (Abs(Low[i] - Close[i + 1]) > tr) then
          tr := Abs(Low[i] - Close[i + 1]);
        somaTR := somaTR + tr;
      end;
      atr2 := (somaTR / PeriodoATR) / 2;
      dev  := DesvioCanal * atr2;

      //--- ATR curto, usado so no filtro de volatilidade
      somaTR := 0;
      for i := 0 to (PeriodoATRFiltro - 1) do
      begin
        tr := High[i] - Low[i];
        if (Abs(High[i] - Close[i + 1]) > tr) then
          tr := Abs(High[i] - Close[i + 1]);
        if (Abs(Low[i] - Close[i + 1]) > tr) then
          tr := Abs(Low[i] - Close[i + 1]);
        somaTR := somaTR + tr;
      end;
      atrFiltro := somaTR / PeriodoATRFiltro;

      //--- maior maxima, menor minima e medias na janela da amplitude
      highPrice := High[0];
      lowPrice  := Low[0];
      somaH     := 0;
      somaL     := 0;
      for i := 0 to (Amplitude - 1) do
      begin
        if (High[i] > highPrice) then highPrice := High[i];
        if (Low[i]  < lowPrice)  then lowPrice  := Low[i];
        somaH := somaH + High[i];
        somaL := somaL + Low[i];
      end;
      highma := somaH / Amplitude;
      lowma  := somaL / Amplitude;

      //--- primeira barra calculavel: semeia o estado
      if (not iniciado) then
      begin
        iniciado     := true;
        trend        := 0;
        nexttrend    := 0;
        maxLowPrice  := Low[0];
        minHighPrice := High[0];
        up           := lowPrice;
        down         := highPrice;
      end;

      trendAnt := trend;
      upAnt    := up;
      downAnt  := down;

      //--- avalia a virada (sempre, sem filtro nenhum)
      if (nexttrend = 1) then
      begin
        if (lowPrice > maxLowPrice) then
          maxLowPrice := lowPrice;

        if ((highma < maxLowPrice) and (Close < Low[1])) then
        begin
          trend        := 1;
          nexttrend    := 0;
          minHighPrice := highPrice;
        end;
      end
      else
      begin
        if (highPrice < minHighPrice) then
          minHighPrice := highPrice;

        if ((lowma > minHighPrice) and (Close > High[1])) then
        begin
          trend       := 0;
          nexttrend   := 1;
          maxLowPrice := lowPrice;
        end;
      end;

      //--- posiciona a linha
      virouCompra := false;
      virouVenda  := false;

      if (trend = 0) then
      begin
        if (trendAnt = 1) then
        begin
          // virou para alta: a linha salta para onde estava a de baixa
          up := downAnt;
          virouCompra := true;
        end
        else
        begin
          // em alta a linha nunca desce
          if (maxLowPrice > upAnt) then
            up := maxLowPrice
          else
            up := upAnt;
        end;
        linha := up;
      end
      else
      begin
        if (trendAnt = 0) then
        begin
          down := upAnt;
          virouVenda := true;
        end
        else
        begin
          // em baixa a linha nunca sobe
          if (minHighPrice < downAnt) then
            down := minHighPrice
          else
            down := downAnt;
        end;
        linha := down;
      end;

      //-----------------------------------------------------------------
      // FILTROS
      // Barram apenas o sinal. O estado acima ja foi atualizado.
      //-----------------------------------------------------------------
      horaOk := true;
      if (FiltroHorario = 1) then
      begin
        // SE NAO COMPILAR NESTA LINHA: troque Time por CurrentTime,
        // ou por Hora, conforme a sua versao do Profit aceitar.
        horaAtual := Time;
        horaOk := (horaAtual >= HoraInicio) and (horaAtual <= HoraFim);
      end;

      volOk := true;
      if (FiltroVolatilidade = 1) then
        volOk := (atrFiltro >= ATRMinimo);

      sinalValido := horaOk and volOk;
    end;

    //-----------------------------------------------------------------
    // plotagem
    //-----------------------------------------------------------------
    PlotN(1, linha);
    if (trend = 0) then
      SetPlotColor(1, clLime)
    else
      SetPlotColor(1, clRed);

    if (MostrarCanal = 1) then
    begin
      PlotN(2, linha + dev);
      PlotN(3, linha - dev);
      SetPlotColor(2, clGray);
      SetPlotColor(3, clGray);
    end
    else
    begin
      PlotN(2, linha);
      PlotN(3, linha);
    end;

    //-----------------------------------------------------------------
    // pintura do candle
    //   cor forte = sinal valido | cinza = barrado pelos filtros
    //-----------------------------------------------------------------
    if (PintarVirada = 1) then
    begin
      if (virouCompra) then
      begin
        if (sinalValido) then
          PaintBar(clLime)
        else if (MarcarFiltrados = 1) then
          PaintBar(clGray);
      end
      else if (virouVenda) then
      begin
        if (sinalValido) then
          PaintBar(clRed)
        else if (MarcarFiltrados = 1) then
          PaintBar(clGray);
      end;
    end;
  end;
end;
