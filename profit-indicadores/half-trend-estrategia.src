//=====================================================================
// HalfTrend — versao ESTRATEGIA
// Para o modulo de Backtest do Profit (Nelogica)
//
// Mesma logica e mesmos filtros do half-trend.src, com as ordens
// embutidas, para o Profit medir o resultado na sua propria base.
//
// REGRAS IMPLEMENTADAS
//   entrada   na virada da linha, a mercado, na barra seguinte
//   filtros   so entre HoraInicio e HoraFim, e so com ATR acima do minimo
//   posicao   2 contratos
//   parcial   1 contrato sai em +AlvoParcial pontos
//   runner    1 contrato sai em +AlvoRunner pontos
//   stop      StopPontos, e vai para o zero a zero depois da parcial
//   dia       encerra tudo em HoraZerar, maximo MaxOperacoesDia entradas
//
// ANTES DE RODAR
//   No painel de Execucao, ajuste a Quantidade para 2.
//   O Profit usa aquele valor como tamanho da posicao.
//
// SE NAO COMPILAR
//   As linhas de ordem (BuyAtMarket, SellToCoverAtMarket,
//   SellShortAtMarket, BuyToCoverAtMarket) sao o ponto de variacao
//   entre versoes. Rode antes o teste-ordens.src para descobrir se a
//   sua versao aceita quantidade como argumento.
//=====================================================================

input
  Amplitude(12);
  DesvioCanal(2.0);
  PeriodoATR(100);
  FiltroHorario(1);
  HoraInicio(900);
  HoraFim(1450);
  HoraZerar(1740);
  FiltroVolatilidade(1);
  ATRMinimo(200);
  PeriodoATRFiltro(14);
  StopPontos(400);
  AlvoParcial(250);
  AlvoRunner(500);
  UsarZeroAZero(1);
  MaxOperacoesDia(2);
  AlvoDiaReais(600);
  ValorPonto(0.20);

var
  i            : integer;
  ultimaBarra  : integer;
  iniciado     : boolean;
  trend        : integer;
  trendAnt     : integer;
  nexttrend    : integer;
  maxLowPrice  : float;
  minHighPrice : float;
  up           : float;
  down         : float;
  upAnt        : float;
  downAnt      : float;
  somaTR       : float;
  tr           : float;
  atr2         : float;
  atrFiltro    : float;
  highPrice    : float;
  lowPrice     : float;
  somaH        : float;
  somaL        : float;
  highma       : float;
  lowma        : float;
  linha        : float;
  horaAtual    : integer;
  horaAnt      : integer;
  horaOk       : boolean;
  volOk        : boolean;
  virouCompra  : boolean;
  virouVenda   : boolean;
  sinalValido  : boolean;
  // controle da operacao
  opsHoje      : integer;
  lucroHoje    : float;
  fezParcial   : boolean;
  precoEntrada : float;
  stopAtual    : float;
  minBarras    : integer;

begin
  minBarras := PeriodoATR + PeriodoATRFiltro + Amplitude + 3;

  if (CurrentBar >= minBarras) then
  begin
    horaAtual := Time;

    //-----------------------------------------------------------------
    // Virada de dia: zera os contadores.
    // Detectada quando a hora anda para tras.
    //-----------------------------------------------------------------
    if (horaAtual < horaAnt) then
    begin
      opsHoje   := 0;
      lucroHoje := 0;
    end;
    horaAnt := horaAtual;

    //-----------------------------------------------------------------
    // Calculo do HalfTrend, uma vez por barra
    //-----------------------------------------------------------------
    if (CurrentBar <> ultimaBarra) then
    begin
      ultimaBarra := CurrentBar;

      somaTR := 0;
      for i := 0 to (PeriodoATR - 1) do
      begin
        tr := High[i] - Low[i];
        if (Abs(High[i] - Close[i + 1]) > tr) then
          tr := Abs(High[i] - Close[i + 1]);
        if (Abs(Low[i] - Close[i + 1]) > tr) then
          tr := Abs(Low[i] - Close[i + 1]);
        somaTR := somaTR + tr;
      end;
      atr2 := (somaTR / PeriodoATR) / 2;

      somaTR := 0;
      for i := 0 to (PeriodoATRFiltro - 1) do
      begin
        tr := High[i] - Low[i];
        if (Abs(High[i] - Close[i + 1]) > tr) then
          tr := Abs(High[i] - Close[i + 1]);
        if (Abs(Low[i] - Close[i + 1]) > tr) then
          tr := Abs(Low[i] - Close[i + 1]);
        somaTR := somaTR + tr;
      end;
      atrFiltro := somaTR / PeriodoATRFiltro;

      highPrice := High[0];
      lowPrice  := Low[0];
      somaH     := 0;
      somaL     := 0;
      for i := 0 to (Amplitude - 1) do
      begin
        if (High[i] > highPrice) then highPrice := High[i];
        if (Low[i]  < lowPrice)  then lowPrice  := Low[i];
        somaH := somaH + High[i];
        somaL := somaL + Low[i];
      end;
      highma := somaH / Amplitude;
      lowma  := somaL / Amplitude;

      if (not iniciado) then
      begin
        iniciado     := true;
        trend        := 0;
        nexttrend    := 0;
        maxLowPrice  := Low[0];
        minHighPrice := High[0];
        up           := lowPrice;
        down         := highPrice;
      end;

      trendAnt := trend;
      upAnt    := up;
      downAnt  := down;

      if (nexttrend = 1) then
      begin
        if (lowPrice > maxLowPrice) then
          maxLowPrice := lowPrice;
        if ((highma < maxLowPrice) and (Close < Low[1])) then
        begin
          trend        := 1;
          nexttrend    := 0;
          minHighPrice := highPrice;
        end;
      end
      else
      begin
        if (highPrice < minHighPrice) then
          minHighPrice := highPrice;
        if ((lowma > minHighPrice) and (Close > High[1])) then
        begin
          trend       := 0;
          nexttrend   := 1;
          maxLowPrice := lowPrice;
        end;
      end;

      virouCompra := false;
      virouVenda  := false;

      if (trend = 0) then
      begin
        if (trendAnt = 1) then
        begin
          up := downAnt;
          virouCompra := true;
        end
        else
        begin
          if (maxLowPrice > upAnt) then up := maxLowPrice else up := upAnt;
        end;
        linha := up;
      end
      else
      begin
        if (trendAnt = 0) then
        begin
          down := upAnt;
          virouVenda := true;
        end
        else
        begin
          if (minHighPrice < downAnt) then down := minHighPrice else down := downAnt;
        end;
        linha := down;
      end;

      horaOk := true;
      if (FiltroHorario = 1) then
        horaOk := (horaAtual >= HoraInicio) and (horaAtual <= HoraFim);

      volOk := true;
      if (FiltroVolatilidade = 1) then
        volOk := (atrFiltro >= ATRMinimo);

      sinalValido := horaOk and volOk;
    end;

    //-----------------------------------------------------------------
    // GESTAO DA POSICAO ABERTA
    //-----------------------------------------------------------------
    if (IsBought) then
    begin
      // encerramento do dia
      if (horaAtual >= HoraZerar) then
        SellToCoverAtMarket(2)
      else
      begin
        // stop
        if (Low <= stopAtual) then
        begin
          SellToCoverAtMarket(2);
          lucroHoje := lucroHoje + ((stopAtual - precoEntrada) * 2 * ValorPonto);
        end
        else
        begin
          // parcial
          if (not fezParcial) then
          begin
            if (High >= (precoEntrada + AlvoParcial)) then
            begin
              SellToCoverAtMarket(1);
              fezParcial := true;
              lucroHoje  := lucroHoje + (AlvoParcial * ValorPonto);
              if (UsarZeroAZero = 1) then
                stopAtual := precoEntrada;
            end;
          end
          else
          begin
            // runner
            if (High >= (precoEntrada + AlvoRunner)) then
            begin
              SellToCoverAtMarket(1);
              lucroHoje := lucroHoje + (AlvoRunner * ValorPonto);
            end;
          end;
        end;
      end;
    end
    else if (IsSold) then
    begin
      if (horaAtual >= HoraZerar) then
        BuyToCoverAtMarket(2)
      else
      begin
        if (High >= stopAtual) then
        begin
          BuyToCoverAtMarket(2);
          lucroHoje := lucroHoje + ((precoEntrada - stopAtual) * 2 * ValorPonto);
        end
        else
        begin
          if (not fezParcial) then
          begin
            if (Low <= (precoEntrada - AlvoParcial)) then
            begin
              BuyToCoverAtMarket(1);
              fezParcial := true;
              lucroHoje  := lucroHoje + (AlvoParcial * ValorPonto);
              if (UsarZeroAZero = 1) then
                stopAtual := precoEntrada;
            end;
          end
          else
          begin
            if (Low <= (precoEntrada - AlvoRunner)) then
            begin
              BuyToCoverAtMarket(1);
              lucroHoje := lucroHoje + (AlvoRunner * ValorPonto);
            end;
          end;
        end;
      end;
    end
    else
    begin
      //---------------------------------------------------------------
      // SEM POSICAO: avalia entrada
      //---------------------------------------------------------------
      if (sinalValido) then
      begin
        if (opsHoje < MaxOperacoesDia) then
        begin
          if (lucroHoje < AlvoDiaReais) then
          begin
            if (virouCompra) then
            begin
              BuyAtMarket(2);
              precoEntrada := Close;
              stopAtual    := Close - StopPontos;
              fezParcial   := false;
              opsHoje      := opsHoje + 1;
            end
            else if (virouVenda) then
            begin
              SellShortAtMarket(2);
              precoEntrada := Close;
              stopAtual    := Close + StopPontos;
              fezParcial   := false;
              opsHoje      := opsHoje + 1;
            end;
          end;
        end;
      end;
    end;
  end;
end;
